# HTTP server
PORT=3001
EPAPER_HOST=0.0.0.0

# Optional. The default is derived from PORT and normally does not need changing.
# EPAPER_BASE_URL=http://127.0.0.1:3001

# Linux examples: /usr/bin/google-chrome-stable or /usr/bin/chromium
# The application also detects common Chrome/Chromium installation paths automatically.
EPAPER_CHROME_PATH=/usr/bin/google-chrome-stable

# Weather cities. The first item is the default used when no ?city= key is
# supplied. Add as many city entries as needed; keys must be unique.
WEATHER_CITIES='[{"key":"beijing","cityId":"0101010102","name":"Beijing"}]'

# Optional. Increase this on low-resource servers (default: 120000, minimum: 10000).
# EPAPER_CHROME_TIMEOUT_MS=180000

# Run Chrome at a lower Linux CPU scheduling priority (0-19; higher is gentler).
EPAPER_CHROME_NICE=10

# Pause between images to avoid sustained CPU spikes on small servers.
EPAPER_EXPORT_DELAY_MS=5000

# Cache upstream weather and exchange responses for this duration.
WEATHER_CACHE_TTL_MS=300000
EXCHANGE_RATE_CACHE_TTL_MS=300000

# Fail the hourly job if an upstream service is unavailable and fallback data is rendered.
EPAPER_REQUIRE_LIVE_DATA=true
