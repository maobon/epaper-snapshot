# HTTP server
PORT=3001
EPAPER_HOST=0.0.0.0

# Optional. The default is derived from PORT and normally does not need changing.
# EPAPER_BASE_URL=http://127.0.0.1:3001

# Linux examples: /usr/bin/google-chrome-stable or /usr/bin/chromium
# The application also detects common Chrome/Chromium installation paths automatically.
EPAPER_CHROME_PATH=/usr/bin/google-chrome-stable
